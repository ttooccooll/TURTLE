# Nostr Wallet Connect (NIP-47) connection string from your wallet.
#
# Alby Hub: Connections -> Add Connection. Scope it to make_invoice and
# lookup_invoice ONLY. This secret lives on a web server, so it must never be
# able to spend: do not grant pay_invoice.
#
# Swapping wallets later means changing this one line and nothing else.
NWC_URL=nostr+walletconnect://<wallet-pubkey>?relay=wss://relay.getalby.com/v1&secret=<hex-secret>
